# obsidian-vault-mcp settings. Copy to /etc/obsidian-vault-mcp/env (chmod 600) and fill in.
# Placeholder values only. Never commit the real file.

# Required: absolute path to the vault folder on this machine.
VAULT_DIR=/path/to/your/vault

# Required: shared secret the client must send as "Authorization: Bearer <token>".
# At least 32 characters. Generate one with: openssl rand -hex 32
MCP_TOKEN=replace-with-output-of-openssl-rand-hex-32

# Port on 127.0.0.1 (the server never binds to other interfaces).
PORT=8787

# read (default): read tools only. write: adds create, append, replace and property edits.
# full is reserved for future delete and move tools; the server refuses to start with it.
ACCESS_MODE=read

# Host header names to accept, comma-separated. Add your tunnel's public hostname
# if requests arrive with it (for example through a Cloudflare Tunnel).
ALLOWED_HOSTS=localhost,127.0.0.1

# Vault-relative folders that are never written to, comma-separated.
READONLY_DIRS=

# Vault-relative folder where create_note puts notes given only a title. Empty = vault root.
INBOX_DIR=

# Daily notes. Used only when .obsidian/daily-notes.json is missing or leaves a field empty.
# DAILY_FORMAT is a Moment.js format. DAILY_TEMPLATE is a vault-relative note path.
DAILY_DIR=
DAILY_FORMAT=YYYY-MM-DD
DAILY_TEMPLATE=

# Time zone for "today" in daily notes. Containers often default to UTC.
# Uncomment and set to your zone, for example Region/City.
# TZ=Region/City

# systemd unit that runs Obsidian Sync. Empty disables the check.
SYNC_UNIT=obsidian-sync

# Where the obsidian-headless CLI (ob) keeps its state, for last-sync time.
# Default: $XDG_CONFIG_HOME/obsidian-headless or ~/.config/obsidian-headless on Linux.
OB_CONFIG_DIR=

# Warn at the top of every tool result when the newest vault change is older than this.
STALE_HOURS=24

# Size limits in bytes.
IMAGE_MAX_BYTES=5242880
READ_MAX_BYTES=1048576
WRITE_MAX_BYTES=1048576
SEARCH_MAX_RESULTS=200

# Optional tool paths.
RG_PATH=rg
SYSTEMCTL_PATH=systemctl
