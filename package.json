{
  "name": "obsidian-vault-mcp",
  "version": "0.1.0",
  "description": "A small, auditable MCP server for an Obsidian vault on disk.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "moment": "2.31.0",
    "picomatch": "4.0.7",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.19.1",
    "@types/picomatch": "4.0.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
